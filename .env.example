# Copy to .env.local for local work. These are placeholders; no live database is needed to view the design preview.
# Use Supabase's pooled connection string for application traffic and its direct connection for Prisma CLI operations.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Reserved for the future Supabase Auth integration. Keep service-role secrets server-only.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
